# ── Tourist Safety App — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Optional: NewsAPI.org key (free tier: 100 requests/day)
# Leave blank to use GDELT + Google News RSS only (both are free, no key needed)
NEWS_API_KEY=

# Region config — change these to target a different city/district
REGION_NAME=Ernakulam
REGION_DISPLAY=Ernakulam / Kochi, Kerala
REGION_LAT=9.9312
REGION_LON=76.2673
REGION_BBOX_SOUTH=9.8
REGION_BBOX_NORTH=10.2
REGION_BBOX_WEST=76.1
REGION_BBOX_EAST=76.5

# OSM admin level for the region (5 = district in India)
ADMIN_LEVEL=5

# H3 resolution (8 = ~0.7 km² cells)
H3_RES=8

# News refresh interval in minutes
NEWS_REFRESH_MINUTES=20

# Nominatim user-agent (required by OSM policy — put your project name/email)
NOMINATIM_USER_AGENT=TouristSafetyApp/1.0 (your-email@example.com)

# CORS origin for the frontend during development
FRONTEND_ORIGIN=*

# SQLite database path (relative to project root)
DB_PATH=data/places.db
